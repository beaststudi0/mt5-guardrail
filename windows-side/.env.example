# Copy this file to .env and fill in real values. .env is gitignored;
# .env.example is the only version meant to be committed.
#
# All settings are validated at process start (pydantic-settings) - a
# missing required value or a value of the wrong type fails immediately
# with a clear error, not on the first request.

# ============================================================
# REQUIRED - the bridge will not start without these
# ============================================================

# Shared secret the client must send as the x-api-key header on every
# request. Generate a real one, at least 16 characters, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MT5_BRIDGE_API_KEY=

# Your MT5 account login number.
MT5_LOGIN=

# Your MT5 account password.
MT5_PASSWORD=

# Your broker's server name, exactly as shown in the MT5 terminal's
# login screen (e.g. "SomeBroker-Demo" or "SomeBroker-Live-01").
MT5_SERVER=

# ============================================================
# OPTIONAL - sensible defaults shown; uncomment to override
# ============================================================

# --- Bridge server ---
# MT5_BRIDGE_HOST=127.0.0.1
# MT5_BRIDGE_PORT=8787
# MT5_BRIDGE_LOG=mt5_bridge.log
# MT5_LOG_LEVEL=INFO

# --- MT5 terminal connection ---
# Only needed if MetaTrader 5 is installed somewhere non-standard.
# MT5_TERMINAL_PATH=
# MT5_CONNECT_RETRIES=3
# MT5_CONNECT_BACKOFF_SEC=1.5

# --- Safety guardrails ---
# Comma-separated list of symbols this bridge is allowed to trade.
# Every other symbol is rejected with SymbolNotAllowed before any order
# reaches the broker.
# MT5_ALLOWED_SYMBOLS=US100Cash
#
# Hard ceiling on the volume (lot size) of any single order.
# MT5_MAX_LOT_SIZE=0.10
#
# Circuit breaker: max orders this bridge will send in a calendar day
# (UTC), across all symbols.
# MT5_MAX_DAILY_ORDERS=20
#
# If true (default), execute requires a confirm_token from a matching
# preview call first. Setting this to false lets a caller execute
# directly with no preview step - see the warning this bridge logs at
# startup if you do this; it is a real safety trade-off, not a toggle
# to flip without thinking about it.
# MT5_REQUIRE_CONFIRM_TOKEN=true
#
# If true (default), execute refuses to open a new position unless the
# connected MT5 account is a demo account (MT5's own trade_mode == 0).
# This is what stops a fresh clone of this project from accidentally
# trading a live account on first run. It does NOT affect close() -
# an existing live position can always be closed through this bridge,
# demo-only or not. Set to false only once you've verified your own
# agent's behavior and deliberately intend to trade a live account -
# see the warning this bridge logs at startup if you do this.
# MT5_REQUIRE_DEMO_ACCOUNT=true
#
# How long (seconds) a confirm_token stays valid after preview.
# MT5_CONFIRM_TOKEN_TTL=60
#
# Max price deviation (in points) MT5 will accept before rejecting a
# market order as slippage.
# MT5_ORDER_DEVIATION=20
#
# Tags every order this bridge sends, so you can distinguish its trades
# from manual ones in the MT5 terminal's own history.
# MT5_MAGIC_NUMBER=990011

# --- Performance tuning ---
# MT5_SYMBOL_CACHE_TTL=30.0
# MT5_CONNECTION_CHECK_INTERVAL=5.0

# --- Journal (local trade history in SQLite) ---
# MT5_JOURNAL_ENABLED=true
# MT5_JOURNAL_DB=trade_journal.sqlite3

# --- Notifications (optional webhook, e.g. Discord) ---
# MT5_WEBHOOK_URL=
