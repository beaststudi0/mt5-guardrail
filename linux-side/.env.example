# Copy this file to .env and fill in real values (or export these
# directly in your shell profile). .env is gitignored.
#
# Unlike windows-side, mt5_client reads these via plain os.environ, not
# pydantic-settings - there is no automatic .env loading built in here.
# Either export these yourself, or use a tool like `python-dotenv` /
# `direnv` if you want file-based loading in your own shell setup.

# ============================================================
# REQUIRED
# ============================================================

# Must be EXACTLY the same value as MT5_BRIDGE_API_KEY in the
# windows-side .env - this is the shared secret between the two sides.
MT5_BRIDGE_API_KEY=

# ============================================================
# OPTIONAL
# ============================================================

# Where to reach the bridge. If unset, defaults to
# http://localhost:8787, which works when WSL2 is in "mirrored"
# networking mode. In older NAT mode, use BridgeClient.autodiscover()
# instead of from_env(), or find the Windows host's WSL-visible IP
# manually and set it here (see mt5_client/config.py's module docstring
# for how WSL2 NAT mode exposes the host).
# MT5_BRIDGE_URL=http://localhost:8787

# Per-request timeout, in seconds.
# MT5_BRIDGE_TIMEOUT=10
